datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  assistant
  admin
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AgentStatus {
  IDLE
  BUSY
  OFFLINE
}

enum PlanType {
  FREE
  PRO
  PREMIUM
}
// prisma/schema.prisma

model User {
  id             String      @id @default(uuid())
  clerkId        String      @unique
  email          String      @unique
  name           String?     // Full Name
  username       String?     @unique
  avatar         String?     // URL to avatar image
  bio            String?     // Free‑form bio
  role           Role        @default(user)

  // relations...
  projects       Project[]
  subscription   Subscription?
  usage          Usage?
  referralsSent  Referral[]  @relation("Referrer")
  referredBy     Referral?   @relation("Referred")

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}


model Subscription {
  id             String     @id @default(uuid())
  userId         String     @unique
  plan           PlanType
  stripeCustomerId String?
  stripeSubId    String?
  status         String     // active, canceled, trialing
  startDate      DateTime
  endDate        DateTime?
  user           User       @relation(fields: [userId], references: [id])
}

model Usage {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  aiAgentsCreated        Int      @default(0)
  tasksExecuted          Int      @default(0)
  workflowsCreated       Int      @default(0)
  integrationsConnected  Int      @default(0)
  projectsCreated        Int      @default(0)

  user                   User     @relation(fields: [userId], references: [id])
  lastReset              DateTime @default(now())
}

model Referral {
  id             String   @id @default(uuid())
  code           String   @unique
  referrerId     String
  referredId     String @unique

  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])
  referred       User     @relation("Referred", fields: [referredId], references: [id])
  createdAt      DateTime @default(now())
}

model Project {
  id                String        @id @default(uuid())
  name              String
  description       String?
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id])

  // Metrics
  views             Int           @default(0)
  lastActivityAt    DateTime?
  favorite          Boolean       @default(false)
  tag               String?

  workflows         Workflow[]
  agents            Agent[]
  integrations      Integration[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Workflow {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  description   String?
  steps         Json?
  tasks         Task[]
  project       Project   @relation(fields: [projectId], references: [id])

  usageCount    Int       @default(0)
  isTemplate    Boolean   @default(false)
  version       Int       @default(1)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Task {
  id            String     @id @default(uuid())
  workflowId    String
  name          String
  description   String?
  parameters    Json?
  logs          Json?
  status        TaskStatus @default(PENDING)
  agentId       String?
  agent         Agent?     @relation(fields: [agentId], references: [id])
  workflow      Workflow   @relation(fields: [workflowId], references: [id])

  executionTime Float?     // in seconds
  retryCount    Int        @default(0)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Agent {
  id            String       @id @default(uuid())
  projectId     String
  name          String
  type          String
  status        AgentStatus  @default(IDLE)

  // AI features
  version       String
  metadata      Json?
  skills        String[]      // e.g., ["email automation", "data extraction"]

  tasks         Task[]
  project       Project       @relation(fields: [projectId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Integration {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  provider      String
  config        Json?
  active        Boolean   @default(true)
  usageCount    Int       @default(0)
  syncedAt      DateTime?

  project       Project   @relation(fields: [projectId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
